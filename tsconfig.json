{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "server.mjs",
    "app/**/*.js",
    "app/**/*.d.ts"
  ]
}
